# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ARTCRAFT_API_TOKEN=replace-with-a-random-token-of-at-least-24-characters
GITHUB_TOKEN=
# Operator installation uses docker compose exec. LLM tools do not expose install.
ARTCRAFT_ALLOW_API_INSTALL=0
# Check GitHub for new repositories/resources/versions every six hours.
# Use 3600 for hourly, 86400 for daily, or 0 to disable scheduled checks.
ARTCRAFT_REFRESH_SECONDS=21600
# setup-pullio.sh fills these after the worker image has been published.
ARTCRAFT_IMAGE=
ARTCRAFT_PROJECT_DIR=
PULLIO_INTERVAL_SECONDS=21600
